# Copy to .env and adjust.

# Name of the single room (shown as #name). Your backend can override it.
VITE_ROOM_NAME=mainframe

# Nightly window, local device time, 24h "HH:MM". Opens at OPEN, closes at CLOSE.
VITE_OPEN_AT=20:00
VITE_CLOSE_AT=21:00

# "mock" runs fully offline with fake members (for design/testing).
# "http" talks to your backend (see src/api/http.ts and README).
VITE_BACKEND=mock
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws

# Access code accepted by the mock backend only.
VITE_MOCK_CODE=UNDERGROUND
